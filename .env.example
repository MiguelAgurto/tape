# Copy to .env for local dev. In production these are set as Netlify
# environment variables (Site settings → Environment variables).
#
# None of these are secrets: the Appwrite project ID and endpoint are public by
# design, and this backend uses no Appwrite Auth — the tables and bucket are
# open to the "Any" role. See the security note in README.md.

VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a8b4af8003e44567baa
VITE_APPWRITE_DATABASE_ID=6a8cd080000e8fc3d47e
VITE_APPWRITE_PHOTOS_BUCKET_ID=6a8cd3a5002ea638ede7
